<?xml version="1.0" encoding="utf-8"?>
<!-- Setup, grouped into cards. Saved when leaving the screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="Back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Basics -->
            <com.google.android.material.card.MaterialCardView style="@style/RelayCard">
                <LinearLayout style="@style/RelayCardBody">
                    <TextView style="@style/RelayCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drone name" />
                    <TextView style="@style/RelayHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The label others see on the TAK map." />
                    <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                        android:hint="Callsign">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/callsign"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Video -->
            <com.google.android.material.card.MaterialCardView style="@style/RelayCard">
                <LinearLayout style="@style/RelayCardBody">
                    <TextView style="@style/RelayCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video server" />
                    <TextView style="@style/RelayHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The MediaMTX server the live view is sent to." />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/mtxProtocol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/protoRtsp"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RTSP" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/protoSrt"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SRT" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                        android:hint="Server address">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mtxHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                            android:id="@+id/mtxPortLayout"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="Port">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/mtxPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                            android:id="@+id/mtxSrtPortLayout"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="SRT">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/mtxSrtPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="2"
                            android:hint="Stream name">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/mtxPath"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:hint="Username (optional)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/mtxUser"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:hint="Password"
                            app:endIconMode="password_toggle">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/mtxPass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/mtxSrtLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Viewers watch over SRT too" />
                    <TextView style="@style/RelayHelp"
                        android:id="@+id/mtxSrtLinkHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Off: the map marker links the RTSP stream, which every TAK app plays. MediaMTX serves an SRT upload over both." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CoT -->
            <com.google.android.material.card.MaterialCardView style="@style/RelayCard">
                <LinearLayout style="@style/RelayCardBody">
                    <TextView style="@style/RelayCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Map marker" />
                    <TextView style="@style/RelayHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Where to send the drone marker (with the video attached)." />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/multicast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Local network / mesh (multicast)" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/takEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TAK Server" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanQr"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Scan TAK Server QR code"
                        app:icon="@drawable/ic_qr" />

                    <LinearLayout
                        android:id="@+id/takFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                            android:hint="TAK Server address">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/takHost"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="Enroll port">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/takEnrollPort"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                                android:layout_width="0dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:hint="CoT port">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/takStreamPort"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                                android:layout_width="0dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:hint="API port">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/takApiPort"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="Username">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/takUser"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                                android:layout_width="0dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:hint="Password"
                                app:endIconMode="password_toggle">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/takPass"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPassword" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/enroll"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Get certificate" />
                        <TextView
                            android:id="@+id/enrollStatus"
                            style="@style/RelayHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Channels"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/text" />
                        <TextView style="@style/RelayHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Who sees the drone. Channels belong to your TAK account, so changing them here changes them on any other device signed in as you." />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/loadChannels"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Choose channels" />
                        <LinearLayout
                            android:id="@+id/channelList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                        <TextView
                            android:id="@+id/channelStatus"
                            style="@style/RelayHelp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Remote ID -->
            <com.google.android.material.card.MaterialCardView style="@style/RelayCard">
                <LinearLayout style="@style/RelayCardBody">
                    <TextView style="@style/RelayCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drone position" />
                    <TextView style="@style/RelayHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Uses the drone's Remote ID broadcast when the phone hears it; otherwise the marker sits at your phone." />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ridEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Listen for Remote ID" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                        android:id="@+id/ridSerialLayout"
                        android:hint="Drone serial (blank = first heard)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ridSerial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:id="@+id/capability"
                        style="@style/RelayHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced -->
            <com.google.android.material.card.MaterialCardView style="@style/RelayCard">
                <LinearLayout style="@style/RelayCardBody">
                    <TextView style="@style/RelayCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Advanced" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/lowBandwidth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Low bandwidth (cellular): 720p, 15 fps, 1.5 Mbps max" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                        android:hint="Video bitrate (kbps)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/bitrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/mtxTcp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Send RTSP over TCP" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/cropToFly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Crop to DJI Fly's picture" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/RelayField"
                        android:id="@+id/flyLeftPctLayout"
                        android:hint="Picture left edge (% of screen)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/flyLeftPct"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
