<?xml version="1.0" encoding="utf-8"?>
<!-- Home: one big Start/Stop, and three status rows. Setup lives behind the gear.
     fitsSystemWindows: targetSdk 35 forces edge-to-edge, so pad for the system bars. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<!-- Own padding lives here: fitsSystemWindows replaces the padding of the view it is on. -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UAS Relay"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Big button, centered in the free space -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startStop"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="START"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                app:backgroundTint="@color/go"
                app:cornerRadius="100dp"
                app:elevation="6dp" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:maxWidth="300dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </FrameLayout>

    <!-- Status -->
    <com.google.android.material.card.MaterialCardView style="@style/RelayCard">

        <LinearLayout
            style="@style/RelayCardBody"
            android:paddingVertical="8dp">

            <include
                android:id="@+id/rowVideo"
                layout="@layout/status_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline" />

            <include
                android:id="@+id/rowCot"
                layout="@layout/status_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline" />

            <include
                android:id="@+id/rowPosition"
                layout="@layout/status_row" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
</FrameLayout>
